{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/vitest"],
  "files": {
    "includes": ["!**/public"]
  },
  "linter": {
    "rules": {
      "nursery": {
        // Enabled in Ultracite 8.1 / Biome 2.6; defer a dedicated class-sort pass.
        "useTailwindSortedClasses": "off"
      }
    }
  }
}
