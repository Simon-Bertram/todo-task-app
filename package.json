{
  "name": "todo-task-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "perf"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @todo-task-app/db --",
    "deploy": "turbo run deploy -F @todo-task-app/infra --",
    "destroy": "turbo run destroy -F @todo-task-app/infra --",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev:bare -F hono --",
    "dev:web": "turbo run dev:bare -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "perf:api": "pnpm --filter @todo-task-app/perf api",
    "perf:auth": "pnpm --filter @todo-task-app/perf auth",
    "perf:check": "pnpm --filter @todo-task-app/perf check",
    "perf:compare": "node ./perf/compare.mjs",
    "perf:crud": "pnpm --filter @todo-task-app/perf crud",
    "perf:islands": "pnpm --filter @todo-task-app/perf islands",
    "perf:lh": "pnpm --filter @todo-task-app/perf lh",
    "test": "turbo run test"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "catalog:",
    "@todo-task-app/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
