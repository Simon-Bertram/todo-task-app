# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
PUBLIC_SERVER_URL=

# Cloudflare Turnstile sitekey for pre-auth forms (client-visible).
# Default is the official always-pass visible test sitekey (local/dev only).
# Production must use a real widget sitekey paired with TURNSTILE_SECRET_KEY.
# @public @docs(https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
# @type=string(minLength=1)
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
