---
import TodayBoard from "../components/today/today-board.astro";
import AppShell from "../layouts/app-shell.astro";
import { loadAppBoardData } from "../lib/orpc.server";

const data = await loadAppBoardData(Astro.request);
if (data === "unauthorized") {
  return Astro.redirect("/login");
}

const { tasks, projects } = data;
---

<AppShell
  mobileTitle="PlanSage / Today"
  projects={projects}
  tasks={tasks}
  title="Today · PlanSage"
>
  <TodayBoard projects={projects} tasks={tasks} />
</AppShell>
