---
import TodayBoard from "../components/islands/today-board";
import AppShell from "../layouts/app-shell.astro";
import { loadAppBoardData } from "../lib/orpc.server";

const data = await loadAppBoardData(Astro.request);
if (data === "unauthorized") {
  return Astro.redirect("/login");
}

const { tasks, projects, dailyCapacityMinutes } = data;
---

<AppShell
  budgetMinutes={dailyCapacityMinutes}
  mobileTitle="PlanSage / Today"
  projects={projects}
  tasks={tasks}
  title="Today · PlanSage"
>
  <TodayBoard
    budgetMinutes={dailyCapacityMinutes}
    projects={projects}
    tasks={tasks}
    client:load
  />
</AppShell>
