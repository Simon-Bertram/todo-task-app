---
import AvatarPicker from "../components/islands/avatar-picker";
import CapacitySettings from "../components/islands/capacity-settings";
import GamificationSettings from "../components/islands/gamification-settings";
import SetupChecklist from "../components/islands/setup-checklist";
import AppShell from "../layouts/app-shell.astro";
import {
  createServerClient,
  isUnauthorized,
  loadAppBoardData,
} from "../lib/orpc.server";
import { loadSessionUser } from "../lib/session.server";

const { requestId } = Astro.locals;
const data = await loadAppBoardData(Astro.request, {
  includeCompleted: true,
  requestId,
});
if (data === "unauthorized") {
  return Astro.redirect("/login");
}

const sessionUser = await loadSessionUser(Astro.request);
if (!sessionUser) {
  return Astro.redirect("/login");
}

const { tasks, projects, dailyCapacityMinutes, taskProgressControl } = data;

let celebrations: "subtle" | "off" = "subtle";
let onboardingCompletedAt: Date | null = null;
let rhythmOptIn = false;
let rhythmBest = 0;
let rhythmCurrent = 0;
let initialTaskProgressControl = taskProgressControl;

try {
  const client = createServerClient(Astro.request, { requestId });
  const prefs = await client.preferences.get();
  ({
    celebrations,
    onboardingCompletedAt,
    rhythmBest,
    rhythmCurrent,
    rhythmOptIn,
  } = prefs);
  initialTaskProgressControl = prefs.taskProgressControl;
} catch (error) {
  if (isUnauthorized(error)) {
    return Astro.redirect("/login");
  }
}
---

<AppShell
  budgetMinutes={dailyCapacityMinutes}
  mobileTitle="PlanSage / Settings"
  projects={projects}
  taskProgressControl={initialTaskProgressControl}
  tasks={tasks}
  title="Settings · PlanSage"
>
  <div class="mx-auto max-w-xl space-y-6 px-4 py-6 lg:px-8">
    <header>
      <h1 class="font-semibold text-2xl tracking-tight text-text-primary">
        Settings
      </h1>
      <p class="mt-1 text-sm text-text-secondary">
        Preferences for your daily capacity and execution board.
      </p>
    </header>
    <AvatarPicker
      initialImage={sessionUser.image}
      initialName={sessionUser.name}
      redirectTo="/settings"
      variant="settings"
      client:load
    />
    <SetupChecklist
      capacitySet={dailyCapacityMinutes !== 300}
      dismissed={Boolean(onboardingCompletedAt)}
      projects={projects}
      tasks={tasks}
      client:load
    />
    <CapacitySettings initialMinutes={dailyCapacityMinutes} client:load />
    <GamificationSettings
      initialCelebrations={celebrations}
      initialRhythmOptIn={rhythmOptIn}
      initialTaskProgressControl={initialTaskProgressControl}
      rhythmBest={rhythmBest}
      rhythmCurrent={rhythmCurrent}
      client:load
    />
  </div>
</AppShell>
