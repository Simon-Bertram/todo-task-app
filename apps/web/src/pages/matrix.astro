---
import DesktopMatrixBoard from "../components/islands/desktop-matrix-board";
import MobileMatrix from "../components/islands/mobile-matrix";
import AppShell from "../layouts/app-shell.astro";
import { loadAppBoardData } from "../lib/orpc.server";
import {
  getTasksByQuadrant,
  getTodayPlannedMinutes,
  getTodayTasks,
} from "../lib/task-helpers";

const data = await loadAppBoardData(Astro.request, {
  requestId: Astro.locals.requestId,
});
if (data === "unauthorized") {
  return Astro.redirect("/login");
}

const { tasks, projects, dailyCapacityMinutes, taskProgressControl } = data;
const tasksByQuadrant = getTasksByQuadrant(tasks);
const plannedMinutes = getTodayPlannedMinutes(tasks);
const todayCount = getTodayTasks(tasks).length;
const backlogCount = tasks.filter((task) => !task.isCompleted).length;
const filter = Astro.url.searchParams.get("filter") ?? "all";
---

<AppShell
  budgetMinutes={dailyCapacityMinutes}
  mobileTitle="PlanSage / Matrix"
  projects={projects}
  taskProgressControl={taskProgressControl}
  tasks={tasks}
  title="Matrix · PlanSage"
>
  <div class="px-4 py-4 lg:px-0 lg:py-0">
    <MobileMatrix
      backlogCount={backlogCount}
      budgetMinutes={dailyCapacityMinutes}
      plannedMinutes={plannedMinutes}
      projects={projects}
      taskProgressControl={taskProgressControl}
      tasksByQuadrant={tasksByQuadrant}
      todayCount={todayCount}
      client:load
    />
  </div>
  <DesktopMatrixBoard
    budgetMinutes={dailyCapacityMinutes}
    initialFilter={filter}
    projects={projects}
    taskProgressControl={taskProgressControl}
    tasks={tasks}
    client:load
  />
</AppShell>
