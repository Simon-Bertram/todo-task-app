---
import ProjectBoard from "../components/islands/project-board";
import AppShell from "../layouts/app-shell.astro";
import { loadAppBoardData } from "../lib/orpc.server";

const data = await loadAppBoardData(Astro.request);
if (data === "unauthorized") {
  return Astro.redirect("/login");
}

const { tasks, projects } = data;
const rawFilter = Astro.url.searchParams.get("project");
let initialFilter = "all";
if (rawFilter === "inbox") {
  initialFilter = "inbox";
} else if (rawFilter && projects.some((project) => project.id === rawFilter)) {
  initialFilter = rawFilter;
}
---

<AppShell
  mobileTitle="PlanSage / Projects"
  projects={projects}
  tasks={tasks}
  title="Projects · PlanSage"
>
  <div class="mx-auto max-w-3xl px-4 py-6 lg:px-8">
    <ProjectBoard
      initialFilter={initialFilter}
      projects={projects}
      tasks={tasks}
      client:load
    />
  </div>
</AppShell>
