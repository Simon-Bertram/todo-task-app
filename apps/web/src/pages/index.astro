---
import hero480Avif from "../assets/hero-skyline-480.avif";
import hero480Jpg from "../assets/hero-skyline-480.jpg";
import hero480Webp from "../assets/hero-skyline-480.webp";
import hero768Avif from "../assets/hero-skyline-768.avif";
import hero768Jpg from "../assets/hero-skyline-768.jpg";
import hero768Webp from "../assets/hero-skyline-768.webp";
import hero1080Avif from "../assets/hero-skyline-1080.avif";
import hero1080Jpg from "../assets/hero-skyline-1080.jpg";
import hero1080Webp from "../assets/hero-skyline-1080.webp";
import hero1440Avif from "../assets/hero-skyline-1440.avif";
import hero1440Jpg from "../assets/hero-skyline-1440.jpg";
import hero1440Webp from "../assets/hero-skyline-1440.webp";
import hero1920Avif from "../assets/hero-skyline-1920.avif";
import hero1920Jpg from "../assets/hero-skyline-1920.jpg";
import hero1920Webp from "../assets/hero-skyline-1920.webp";
import JsonLd from "../components/seo/json-ld.astro";
import SignInForm from "../components/sign-in-form.astro";
import Layout from "../layouts/layout.astro";

const sizes = "100vw";
const avifSrcset = [
  `${hero480Avif.src} 480w`,
  `${hero768Avif.src} 768w`,
  `${hero1080Avif.src} 1080w`,
  `${hero1440Avif.src} 1440w`,
  `${hero1920Avif.src} 1920w`,
].join(", ");
const webpSrcset = [
  `${hero480Webp.src} 480w`,
  `${hero768Webp.src} 768w`,
  `${hero1080Webp.src} 1080w`,
  `${hero1440Webp.src} 1440w`,
  `${hero1920Webp.src} 1920w`,
].join(", ");
const jpegSrcset = [
  `${hero480Jpg.src} 480w`,
  `${hero768Jpg.src} 768w`,
  `${hero1080Jpg.src} 1080w`,
  `${hero1440Jpg.src} 1440w`,
  `${hero1920Jpg.src} 1920w`,
].join(", ");

const pageTitle = "PlanSage — Finish what fits today";
const pageDescription =
  "Stop drowning in endless checklists. Sort work by urgency and importance, then build a time-budgeted Today plan so you finish only what fits—without overcommitting.";

const faqs = [
  {
    answer:
      "PlanSage is a personal task manager for overloaded professionals and indie hackers. It helps you prioritize visually by urgency and importance, then execute inside a daily time budget so you finish only what fits your day.",
    question: "What is PlanSage?",
  },
  {
    answer:
      "Each task has urgency and importance scores from 0 to 3. Scores of 2 or higher place work into Do First, Schedule, Streamline, or Drop so priorities stay visual and actionable. Often called an Eisenhower Matrix—here it’s a practical board for deciding what deserves you now versus later.",
    question: "How do priorities work?",
  },
  {
    answer:
      "So you don’t overbook your day: Today uses a configurable focus budget from 2 to 8 hours (default 5 hours / 300 minutes). A live workload bar turns amber near your limit and red when you overcommit.",
    question: "What is the Today capacity budget?",
  },
  {
    answer:
      "The 1-3-5 filter recommends one major task, a few medium tasks, and several quick wins so your daily mix stays realistic instead of stacking only big work.",
    question: "What is the 1-3-5 filter?",
  },
  {
    answer:
      "PlanSage is for overloaded professionals and indie hackers who need visual prioritization and realistic daily capacity—not another infinite checklist. Sign up to plan today with your focus hours in mind.",
    question: "Who is PlanSage for?",
  },
] as const;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      description: pageDescription,
      name: "PlanSage",
      url: "https://todo.sarl/",
    },
    {
      "@type": "SoftwareApplication",
      applicationCategory: "ProductivityApplication",
      description: pageDescription,
      featureList: [
        "Sort by urgency and importance into Do First, Schedule, Streamline, or Drop",
        "Time-budgeted Today board (2–8 hour capacity)",
        "Live workload bar (green / amber / red)",
        "1-3-5 recommended daily mix",
      ],
      name: "PlanSage",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      operatingSystem: "Web",
      url: "https://todo.sarl/",
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
        name: faq.question,
      })),
    },
  ],
};
---

<!-- Hero photo: Lerone Pieters / Unsplash — prebaked AVIF/WebP ladder for Alchemy passthrough -->
<Layout bare canonicalPath="/" description={pageDescription} title={pageTitle}>
  <JsonLd data={jsonLd} />
  <main class="relative min-h-svh overflow-hidden">
    <picture class="absolute inset-0 size-full">
      <source sizes={sizes} srcset={avifSrcset} type="image/avif">
      <source sizes={sizes} srcset={webpSrcset} type="image/webp">
      <source sizes={sizes} srcset={jpegSrcset} type="image/jpeg">
      <img
        alt=""
        class="size-full object-cover"
        decoding="async"
        fetchpriority="high"
        height={hero480Jpg.height}
        loading="eager"
        src={hero480Jpg.src}
        width={hero480Jpg.width}
      >
    </picture>
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-b from-[#0B0F17]/85 via-[#0B0F17]/35 to-[#0B0F17]/75"
    ></div>

    <div
      class="relative z-10 mx-auto flex min-h-svh w-full max-w-6xl flex-col justify-between gap-10 px-5 py-10 sm:px-8 lg:flex-row lg:items-center lg:gap-16 lg:px-12 lg:py-16"
    >
      <div class="max-w-xl shrink-0 pt-4 lg:pt-0">
        <h1
          class="font-semibold text-5xl text-text-primary tracking-[-0.03em] sm:text-6xl lg:text-7xl"
        >
          PlanSage
        </h1>
        <p
          class="mt-4 max-w-md text-base text-text-primary sm:text-lg"
          data-hero-tagline
        >
          Stop drowning in endless checklists. Decide what matters, then finish
          only what fits your day.
        </p>
        <ul
          class="mt-8 max-w-md space-y-3 text-sm text-text-primary sm:text-base"
          data-feature-list
        >
          <li>
            <span class="font-medium text-text-primary"
              >Know what deserves you</span
            >
            — Score urgency and importance so work lands in Do First, Schedule,
            Streamline, or Drop—not another flat list.
          </li>
          <li>
            <span class="font-medium text-text-primary"
              >Protect your focus hours</span
            >
            — A time-budgeted Today board shows whether today’s plan fits before
            you say yes to more.
          </li>
          <li>
            <span class="font-medium text-text-primary"
              >See overcommitment early</span
            >
            — A live workload bar shifts amber, then red, as you near your daily
            limit (2–8 hours).
          </li>
          <li>
            <span class="font-medium text-text-primary"
              >Balance big and small</span
            >
            — The 1-3-5 filter keeps one major task, a few mediums, and quick
            wins in a realistic mix.
          </li>
        </ul>
      </div>

      <div class="w-full max-w-md lg:ml-auto">
        <SignInForm heading="Get started" headingLevel={2} variant="solid" />
      </div>
    </div>
  </main>

  <section
    class="relative z-10 border-border-contrast border-t bg-canvas px-5 py-16 sm:px-8 lg:px-12"
    id="faq"
  >
    <div class="mx-auto max-w-3xl">
      <h2 class="font-semibold text-2xl text-text-primary tracking-tight">
        Frequently asked questions
      </h2>
      <p class="mt-2 text-sm text-text-secondary sm:text-base">
        How PlanSage helps you prioritize what matters and protect a realistic
        day.
      </p>
      <dl class="mt-10 space-y-8">
        {faqs.map((faq) => (
          <div>
            <dt class="font-medium text-base text-text-primary">
              {faq.question}
            </dt>
            <dd class="mt-2 text-sm text-text-secondary leading-relaxed sm:text-base">
              {faq.answer}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Layout>
