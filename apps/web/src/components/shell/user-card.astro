---
import { initialsFromName } from "@todo-task-app/api/lib/avatars";
import type { SessionUser } from "../../lib/session.server";
import LogoutButton from "../islands/logout-button";

interface Props {
  user: SessionUser;
}

const { user } = Astro.props;
const initials = initialsFromName(user.name);
---

<div class="flex items-center gap-3">
  {user.image ? (
    <img
      alt=""
      class="size-9 shrink-0 rounded-full object-cover"
      height="36"
      src={user.image}
      width="36"
    />
  ) : (
    <div
      aria-hidden="true"
      class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary font-semibold text-on-primary text-sm"
    >
      {initials}
    </div>
  )}
  <div class="min-w-0 flex-1">
    <p class="truncate font-medium text-sm text-text-primary">{user.name}</p>
    <p class="truncate font-mono text-text-muted text-xs">{user.email}</p>
  </div>
  <LogoutButton client:load />
</div>
