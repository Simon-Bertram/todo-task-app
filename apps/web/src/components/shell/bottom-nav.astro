---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: "/today", label: "Today" },
  { href: "/matrix", label: "Matrix" },
  { href: "/projects", label: "Projects" },
  { href: "/settings", label: "Settings" },
] as const;

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<nav
  aria-label="Primary"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-border-contrast bg-[rgb(17_24_39/0.92)] backdrop-blur-[20px] lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom)"
>
  <div class="relative grid h-16 grid-cols-4 items-center px-2">
    {links.slice(0, 2).map((link) => (
      <a
        aria-current={isActive(link.href) ? "page" : undefined}
        class:list={[
          "flex min-h-11 flex-col items-center justify-center gap-0.5 text-xs font-medium",
          isActive(link.href) ? "text-primary" : "text-text-secondary",
        ]}
        href={link.href}
      >
        {link.label}
      </a>
    ))}
    <div
      class="pointer-events-none absolute inset-x-0 -top-6 flex justify-center"
    >
      <button
        aria-label="Quick add task"
        class="pointer-events-auto flex size-12 items-center justify-center rounded-full bg-primary font-semibold text-on-primary text-xl shadow-[0_4px_20px_-2px_rgba(0,0,0,0.65)]"
        id="quick-add-fab"
        type="button"
      >
        +
      </button>
    </div>
    {links.slice(2).map((link) => (
      <a
        aria-current={isActive(link.href) ? "page" : undefined}
        class:list={[
          "flex min-h-11 flex-col items-center justify-center gap-0.5 text-xs font-medium",
          isActive(link.href) ? "text-primary" : "text-text-secondary",
        ]}
        href={link.href}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>
