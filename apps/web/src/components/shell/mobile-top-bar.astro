---
import { initialsFromName } from "@todo-task-app/api/lib/avatars";
import type { SessionUser } from "../../lib/session.server";

interface Props {
  title?: string;
  user?: SessionUser | null;
}

const { title = "PlanSage", user = null } = Astro.props;
const initials = user ? initialsFromName(user.name) : "?";
---

<header
  class="sticky top-0 z-30 flex h-14 items-center justify-between border-b border-border-contrast bg-canvas/90 px-4 backdrop-blur-md lg:hidden"
>
  <div>
    <p class="font-semibold text-lg tracking-tight text-text-primary">
      {title}
    </p>
  </div>
  <div class="flex items-center gap-2">
    <button
      aria-label="Add task"
      class="flex size-11 items-center justify-center rounded-sm border border-border-contrast bg-surface text-primary text-xl"
      id="quick-add-header"
      type="button"
    >
      +
    </button>
    {user?.image ? (
      <img
        alt=""
        class="size-9 rounded-full object-cover"
        height="36"
        src={user.image}
        width="36"
      />
    ) : (
      <div
        aria-hidden="true"
        class="flex size-9 items-center justify-center rounded-full bg-primary font-semibold text-on-primary text-sm"
      >
        {initials}
      </div>
    )}
  </div>
</header>
