---
interface Props {
  budgetMinutes: number;
  capacityPercent: number;
  currentPath: string;
  plannedMinutes: number;
}

const { currentPath, capacityPercent, plannedMinutes, budgetMinutes } =
  Astro.props;

const links = [
  { href: "/today", label: "Today" },
  { href: "/matrix", label: "Matrix" },
  { href: "/projects", label: "Projects" },
  { href: "/settings", label: "Settings" },
] as const;

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

function capacityBarClass(percent: number): string {
  if (percent > 100) {
    return "bg-capacity-over";
  }
  if (percent >= 75) {
    return "bg-capacity-warn";
  }
  return "bg-capacity-ok";
}

const barColor = capacityBarClass(capacityPercent);
---

<aside
  class="hidden h-svh w-60 shrink-0 flex-col border-r border-border-contrast bg-surface-subtle lg:flex"
>
  <div class="border-b border-border-contrast px-5 py-5">
    <a
      class="font-semibold text-2xl tracking-tight text-text-primary"
      href="/today"
    >
      PlanSage
    </a>
    <p class="mt-1 font-mono text-text-muted text-xs">Matrix Flow</p>
  </div>

  <nav aria-label="Primary" class="flex flex-1 flex-col gap-1 px-3 py-4">
    {links.map((link) => (
      <a
        aria-current={isActive(link.href) ? "page" : undefined}
        class:list={[
          "flex min-h-11 items-center rounded-sm px-3 font-medium text-sm transition-colors",
          isActive(link.href)
            ? "bg-surface-elevated text-text-primary"
            : "text-text-secondary hover:bg-surface hover:text-text-primary",
        ]}
        href={link.href}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <div class="space-y-4 border-t border-border-contrast px-5 py-4">
    <div>
      <div class="mb-2 flex items-center justify-between">
        <span class="font-mono text-text-muted text-xs uppercase tracking-wide">
          Capacity
        </span>
        <span class="font-mono text-text-secondary text-xs tabular-metrics">
          {capacityPercent}%
        </span>
      </div>
      <div class="h-1.5 overflow-hidden rounded-full bg-surface">
        <div
          style={`width: ${Math.min(capacityPercent, 100)}%`}
          class:list={["h-full rounded-full transition-all", barColor]}
        ></div>
      </div>
      <p class="mt-1.5 font-mono text-text-muted text-xs tabular-metrics">
        {(plannedMinutes / 60).toFixed(1)}h / {(budgetMinutes / 60).toFixed(1)}h
      </p>
    </div>
    <div class="flex items-center gap-3">
      <div
        aria-hidden="true"
        class="flex size-9 items-center justify-center rounded-full bg-primary font-semibold text-on-primary text-sm"
      >
        A
      </div>
      <div class="min-w-0">
        <p class="truncate font-medium text-sm text-text-primary">Alex R.</p>
        <p class="truncate font-mono text-text-muted text-xs">Demo user</p>
      </div>
    </div>
  </div>
</aside>
