---
---

<div
  class="w-full max-w-md rounded-md border border-border-contrast bg-surface p-6 sm:p-8"
>
  <h1
    class="mb-2 font-semibold text-2xl text-text-primary tracking-tight"
    id="forgot-heading"
  >
    Reset password
  </h1>
  <p class="mb-6 text-sm text-text-secondary">
    Enter your email and we will send a reset link if an account exists.
  </p>

  <form aria-labelledby="forgot-heading" class="space-y-4" id="forgot-form">
    <div class="space-y-1.5">
      <label
        class="block font-medium text-sm text-text-secondary"
        for="forgot-email"
      >
        Email
      </label>
      <input
        autocomplete="email"
        class="min-h-11 w-full rounded-sm border border-border-contrast bg-surface-subtle px-4 text-text-primary placeholder:text-text-muted focus:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        id="forgot-email"
        name="email"
        placeholder="you@example.com"
        required
        type="email"
      >
    </div>

    <p
      aria-live="assertive"
      class="hidden text-capacity-over text-sm"
      id="forgot-form-error"
      role="alert"
      tabindex="-1"
    ></p>

    <p
      aria-live="polite"
      class="hidden text-sm text-text-secondary"
      id="forgot-form-success"
      role="status"
    ></p>

    <button
      class="flex min-h-11 w-full items-center justify-center rounded-sm bg-primary font-semibold text-on-primary text-sm transition-[filter] hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-50"
      type="submit"
    >
      Send reset link
    </button>
  </form>

  <p class="mt-5 text-center text-sm text-text-secondary">
    <a class="text-primary underline hover:brightness-110" href="/#login"
      >Back to sign in</a
    >
  </p>
</div>

<script>
  import { authClient } from "../lib/auth-client";
  import { mapAuthClientError } from "../lib/auth-errors";

  const form = document.getElementById("forgot-form") as HTMLFormElement;
  const emailInput = document.getElementById(
    "forgot-email"
  ) as HTMLInputElement;
  const formError = document.getElementById(
    "forgot-form-error"
  ) as HTMLParagraphElement;
  const formSuccess = document.getElementById(
    "forgot-form-success"
  ) as HTMLParagraphElement;
  const submitButton = form.querySelector(
    'button[type="submit"]'
  ) as HTMLButtonElement;

  function clearMessages() {
    formError.textContent = "";
    formError.classList.add("hidden");
    formSuccess.textContent = "";
    formSuccess.classList.add("hidden");
    emailInput.removeAttribute("aria-invalid");
    emailInput.removeAttribute("aria-describedby");
  }

  function showError(message: string) {
    formError.textContent = message;
    formError.classList.remove("hidden");
    emailInput.setAttribute("aria-invalid", "true");
    emailInput.setAttribute("aria-describedby", "forgot-form-error");
    formError.focus();
  }

  function showSuccess(message: string) {
    formSuccess.textContent = message;
    formSuccess.classList.remove("hidden");
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    clearMessages();
    form.setAttribute("aria-busy", "true");
    submitButton.disabled = true;
    submitButton.textContent = "Sending…";

    try {
      const { error } = await authClient.requestPasswordReset({
        email: emailInput.value,
        redirectTo: `${window.location.origin}/reset-password`,
      });

      if (error) {
        showError(mapAuthClientError(error).body);
        return;
      }

      showSuccess(
        "If this email exists in our system, check your inbox for a reset link."
      );
    } catch {
      showError(
        mapAuthClientError({ message: "An unexpected error occurred." }).body
      );
    } finally {
      form.removeAttribute("aria-busy");
      submitButton.disabled = false;
      submitButton.textContent = "Send reset link";
    }
  });
</script>
