---
---

<div
  class="w-full max-w-md rounded-md border border-border-contrast bg-surface p-6 sm:p-8"
>
  <h1
    class="mb-6 font-semibold text-2xl text-text-primary tracking-tight"
    id="reset-heading"
  >
    Choose a new password
  </h1>

  <form aria-labelledby="reset-heading" class="space-y-4" id="reset-form">
    <div class="space-y-1.5">
      <label
        class="block font-medium text-sm text-text-secondary"
        for="reset-password"
      >
        New password
      </label>
      <input
        aria-describedby="reset-password-hint"
        autocomplete="new-password"
        class="min-h-11 w-full rounded-sm border border-border-contrast bg-surface-subtle px-4 text-text-primary placeholder:text-text-muted focus:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        id="reset-password"
        minlength="12"
        name="password"
        placeholder="••••••••"
        required
        type="password"
      >
      <p class="font-mono text-text-muted text-xs" id="reset-password-hint">
        At least 12 characters
      </p>
    </div>

    <div class="space-y-1.5">
      <label
        class="block font-medium text-sm text-text-secondary"
        for="reset-password-confirm"
      >
        Confirm password
      </label>
      <input
        autocomplete="new-password"
        class="min-h-11 w-full rounded-sm border border-border-contrast bg-surface-subtle px-4 text-text-primary placeholder:text-text-muted focus:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        id="reset-password-confirm"
        minlength="12"
        name="confirm"
        placeholder="••••••••"
        required
        type="password"
      >
    </div>

    <p
      aria-live="assertive"
      class="hidden text-capacity-over text-sm"
      id="reset-form-error"
      role="alert"
      tabindex="-1"
    ></p>

    <button
      class="flex min-h-11 w-full items-center justify-center rounded-sm bg-primary font-semibold text-on-primary text-sm transition-[filter] hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-50"
      type="submit"
    >
      Update password
    </button>
  </form>

  <p class="mt-5 text-center text-sm text-text-secondary">
    <a class="text-primary underline hover:brightness-110" href="/#login"
      >Back to sign in</a
    >
  </p>
</div>

<script>
  import { authClient } from "../lib/auth-client";
  import { mapAuthClientError } from "../lib/auth-errors";

  const form = document.getElementById("reset-form") as HTMLFormElement;
  const passwordInput = document.getElementById(
    "reset-password"
  ) as HTMLInputElement;
  const confirmInput = document.getElementById(
    "reset-password-confirm"
  ) as HTMLInputElement;
  const formError = document.getElementById(
    "reset-form-error"
  ) as HTMLParagraphElement;
  const submitButton = form.querySelector(
    'button[type="submit"]'
  ) as HTMLButtonElement;

  const passwordHintId = "reset-password-hint";
  const formErrorId = "reset-form-error";
  const fields = [passwordInput, confirmInput];
  const token = new URLSearchParams(window.location.search).get("token");

  function clearInvalidState() {
    formError.textContent = "";
    formError.classList.add("hidden");

    for (const field of fields) {
      field.removeAttribute("aria-invalid");
      field.removeAttribute("aria-describedby");
    }

    passwordInput.setAttribute("aria-describedby", passwordHintId);
  }

  function showFormError(message: string) {
    formError.textContent = message;
    formError.classList.remove("hidden");

    for (const field of fields) {
      field.setAttribute("aria-invalid", "true");
      field.setAttribute("aria-describedby", formErrorId);
    }

    passwordInput.setAttribute(
      "aria-describedby",
      `${passwordHintId} ${formErrorId}`
    );
    formError.focus();
  }

  if (!token) {
    showFormError("This reset link is invalid or incomplete.");
    submitButton.disabled = true;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    clearInvalidState();

    if (!token) {
      showFormError("This reset link is invalid or incomplete.");
      return;
    }

    if (passwordInput.value !== confirmInput.value) {
      showFormError("Passwords do not match.");
      return;
    }

    form.setAttribute("aria-busy", "true");
    submitButton.disabled = true;
    submitButton.textContent = "Updating…";

    try {
      const { error } = await authClient.resetPassword({
        newPassword: passwordInput.value,
        token,
      });

      if (error) {
        showFormError(mapAuthClientError(error).body);
        return;
      }

      window.location.href = "/#login";
    } catch {
      showFormError(
        mapAuthClientError({ message: "An unexpected error occurred." }).body
      );
    } finally {
      form.removeAttribute("aria-busy");
      submitButton.disabled = false;
      submitButton.textContent = "Update password";
    }
  });
</script>
