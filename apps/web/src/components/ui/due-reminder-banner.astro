---
import { countDueReminders } from "../../lib/due-date";
import { getLocalDateString, type Task } from "../../lib/task-helpers";

interface Props {
  tasks: Task[];
}

const { tasks } = Astro.props;
const today = getLocalDateString();
const counts = countDueReminders(tasks, today);
const total = counts.overdue + counts.today + counts.soon;

const parts: string[] = [];
if (counts.overdue > 0) {
  parts.push(`${counts.overdue} overdue`);
}
if (counts.today > 0) {
  parts.push(`${counts.today} due today`);
}
if (counts.soon > 0) {
  parts.push(`${counts.soon} due within 2 days`);
}
---

{total > 0 ? (
  <div
    class="rounded-md border border-capacity-warn/40 bg-capacity-warn/10 px-4 py-3 text-sm text-text-primary"
    role="status"
  >
    <p class="font-medium">Due reminders</p>
    <p class="mt-0.5 text-text-secondary">{parts.join(" · ")}</p>
  </div>
) : null}
