---
import { formatMinutes, QUADRANT_META } from "../../lib/quadrant";
import {
  DEFAULT_DAILY_CAPACITY_MINUTES,
  getTaskQuadrant,
  getTodayPlannedMinutes,
  getTodayTasks,
  type Task,
} from "../../lib/task-helpers";
import CapacityBar from "../ui/capacity-bar.astro";

interface Props {
  tasks: Task[];
}

const { tasks } = Astro.props;
const todayTasks = getTodayTasks(tasks);
const plannedMinutes = getTodayPlannedMinutes(tasks);
const budgetMinutes = DEFAULT_DAILY_CAPACITY_MINUTES;
---

<aside
  aria-label="Today dock"
  class="flex w-72 shrink-0 flex-col gap-4 border-l border-border-contrast bg-surface-subtle p-4"
>
  <div>
    <h2 class="font-semibold text-sm text-text-primary">Today's Runway</h2>
    <p class="mt-1 font-mono text-text-muted text-xs">
      {todayTasks.length}
      staged
    </p>
  </div>

  <CapacityBar budgetMinutes={budgetMinutes} plannedMinutes={plannedMinutes} />

  <div
    class="flex min-h-24 flex-col items-center justify-center rounded-sm border border-dashed border-border-contrast bg-canvas/40 px-3 py-4 text-center"
  >
    <p class="font-medium text-sm text-text-secondary">
      Drop task to schedule for Today
    </p>
    <p class="mt-1 font-mono text-text-muted text-xs">
      Visual affordance · DnD later
    </p>
  </div>

  <ul class="flex flex-1 flex-col gap-2 overflow-y-auto">
    {todayTasks.map((task) => {
      const q = getTaskQuadrant(task);
      const meta = QUADRANT_META[q];
      return (
        <li class="rounded-sm border border-border-contrast bg-surface px-3 py-2">
          <div class="flex items-center gap-2">
            <span
              aria-hidden="true"
              class="size-2 shrink-0 rounded-full"
              style={`background: ${meta.colorVar}`}
            />
            <p class="line-clamp-2 font-medium text-sm text-text-primary">
              {task.title}
            </p>
          </div>
          <p class="tabular-metrics mt-1 font-mono text-text-muted text-xs">
            {q} · {formatMinutes(task.estimatedMinutes)}
          </p>
        </li>
      );
    })}
  </ul>

  <a
    class="flex min-h-11 items-center justify-center rounded-sm bg-primary font-semibold text-on-primary text-sm"
    href="/today"
  >
    Open Today board
  </a>
</aside>
