---
import {
  dailyCapacityMinutes,
  getTaskQuadrant,
  getTodayByBucket,
  getTodayPlannedMinutes,
  getTodayTasks,
} from "../../lib/mock-data";
import { capacityTone, formatMinutes } from "../../lib/quadrant";
import TaskCard from "../task/task-card.astro";
import AlertBanner from "../ui/alert-banner.astro";
import CapacityBar from "../ui/capacity-bar.astro";
import EmptySlot from "../ui/empty-slot.astro";

const plannedMinutes = getTodayPlannedMinutes();
const budgetMinutes = dailyCapacityMinutes;
const tone = capacityTone(plannedMinutes, budgetMinutes);
const buckets = getTodayByBucket();
const todayCount = getTodayTasks().length;

const qMinutes = { Q1: 0, Q2: 0, Q3: 0, Q4: 0 };
for (const task of getTodayTasks()) {
  qMinutes[getTaskQuadrant(task)] += task.estimatedMinutes;
}

const segments = [
  { colorClass: "bg-q1", label: "Q1", minutes: qMinutes.Q1 },
  { colorClass: "bg-q2", label: "Q2", minutes: qMinutes.Q2 },
  { colorClass: "bg-q3", label: "Q3", minutes: qMinutes.Q3 },
].filter((segment) => segment.minutes > 0);

const majorSlots = 1;
const mediumSlots = 3;
const quickSlots = 5;
---

<div class="mx-auto max-w-3xl space-y-8 px-4 py-6 lg:px-8">
  <header class="space-y-4">
    <div>
      <p class="font-mono text-text-muted text-xs uppercase tracking-wide">
        Tuesday execution
      </p>
      <h1
        class="mt-1 font-semibold text-2xl tracking-tight text-text-primary sm:text-3xl"
      >
        Daily Execution Board
      </h1>
      <p class="mt-1 text-sm text-text-secondary">
        1-3-5 capacity allocation · {todayCount} tasks staged
      </p>
    </div>

    <div
      class="sticky top-14 z-20 space-y-3 rounded-md border border-border-contrast bg-canvas/95 p-4 backdrop-blur-md lg:top-0"
    >
      <CapacityBar
        budgetMinutes={budgetMinutes}
        plannedMinutes={plannedMinutes}
        segments={segments}
      />
      <div class="flex flex-wrap gap-3 font-mono text-text-muted text-xs">
        <span>Q1: {formatMinutes(qMinutes.Q1)}</span>
        <span>Q2: {formatMinutes(qMinutes.Q2)}</span>
        <span>Q3: {formatMinutes(qMinutes.Q3)}</span>
      </div>
      {tone === "warn" ? (
        <AlertBanner tone="warn">
          Approaching daily budget. Adding another major task may breach{" "}
          {(budgetMinutes / 60).toFixed(0)}h.
        </AlertBanner>
      ) : null}
      {tone === "over" ? (
        <AlertBanner tone="over">
          Over capacity — defer Q2/Q3 work or raise your daily budget in
          Settings.
        </AlertBanner>
      ) : null}
    </div>
  </header>

  <section aria-labelledby="major-heading" class="space-y-3">
    <div class="flex items-baseline justify-between gap-2">
      <h2
        class="font-semibold text-sm text-text-primary uppercase tracking-wide"
        id="major-heading"
      >
        1 Major task
        <span class="font-mono text-text-muted normal-case"> (60–120m)</span>
      </h2>
      <span class="font-mono text-text-muted text-xs tabular-metrics">
        {buckets.major.length}/{majorSlots}
        slotted
      </span>
    </div>
    <div class="space-y-3">
      {buckets.major.map((task) => <TaskCard task={task} variant="today" />)}
      {Array.from({
        length: Math.max(majorSlots - buckets.major.length, 0),
      }).map(() => (
        <EmptySlot
          hint="Browse Matrix · capacity runway"
          href="/matrix"
          label="Slot 1 major task"
        />
      ))}
    </div>
  </section>

  <section aria-labelledby="medium-heading" class="space-y-3">
    <div class="flex items-baseline justify-between gap-2">
      <h2
        class="font-semibold text-sm text-text-primary uppercase tracking-wide"
        id="medium-heading"
      >
        3 Medium tasks
        <span class="font-mono text-text-muted normal-case"> (30–60m)</span>
      </h2>
      <span class="font-mono text-text-muted text-xs tabular-metrics">
        {buckets.medium.length}/{mediumSlots}
        slotted
      </span>
    </div>
    <div class="space-y-3">
      {buckets.medium.map((task) => <TaskCard task={task} variant="today" />)}
      {Array.from({
        length: Math.max(mediumSlots - buckets.medium.length, 0),
      }).map(() => (
        <EmptySlot
          hint={`Capacity runway: ${Math.max(budgetMinutes - plannedMinutes, 0)}m remaining`}
          href="/matrix"
          label="Slot 1 more medium task"
        />
      ))}
    </div>
  </section>

  <section aria-labelledby="quick-heading" class="space-y-3">
    <div class="flex items-baseline justify-between gap-2">
      <h2
        class="font-semibold text-sm text-text-primary uppercase tracking-wide"
        id="quick-heading"
      >
        5 Quick wins
        <span class="font-mono text-text-muted normal-case"> (&lt;15m)</span>
      </h2>
      <span class="font-mono text-text-muted text-xs tabular-metrics">
        {buckets.quick.length}/{quickSlots}
        slotted
      </span>
    </div>
    <div class="space-y-2">
      {buckets.quick.map((task) => <TaskCard task={task} variant="today" />)}
      {Array.from({
        length: Math.max(quickSlots - buckets.quick.length, 0),
      }).map(() => <EmptySlot href="/matrix" label="Add a quick win" />)}
    </div>
  </section>
</div>
