---
import TaskDetailSheet from "../components/islands/task-detail-sheet";
import BottomNav from "../components/shell/bottom-nav.astro";
import MobileTopBar from "../components/shell/mobile-top-bar.astro";
import SideNav from "../components/shell/side-nav.astro";
import { loadSessionUser } from "../lib/session.server";
import {
  DEFAULT_DAILY_CAPACITY_MINUTES,
  getTodayPlannedMinutes,
  type Project,
  type Task,
} from "../lib/task-helpers";
import Layout from "./layout.astro";

interface Props {
  budgetMinutes?: number;
  mobileTitle?: string;
  projects?: Project[];
  tasks?: Task[];
  title?: string;
}

const {
  title = "PlanSage",
  mobileTitle = "PlanSage",
  tasks = [],
  projects = [],
  budgetMinutes = DEFAULT_DAILY_CAPACITY_MINUTES,
} = Astro.props;
const currentPath = Astro.url.pathname;
const plannedMinutes = getTodayPlannedMinutes(tasks);
const capacityPercent = Math.round((plannedMinutes / budgetMinutes) * 100);
const user = await loadSessionUser(Astro.request);
if (!user) {
  return Astro.redirect("/login");
}
---

<Layout robots="noindex, nofollow" title={title}>
  <div class="flex min-h-svh bg-canvas">
    <SideNav
      budgetMinutes={budgetMinutes}
      capacityPercent={capacityPercent}
      currentPath={currentPath}
      plannedMinutes={plannedMinutes}
      user={user}
    />
    <div class="flex min-w-0 flex-1 flex-col">
      <MobileTopBar title={mobileTitle} user={user} />
      <main class="flex-1 overflow-x-hidden pb-24 lg:pb-0">
        <slot />
      </main>
      <BottomNav currentPath={currentPath} />
    </div>
  </div>
  <TaskDetailSheet
    budgetMinutes={budgetMinutes}
    plannedMinutes={plannedMinutes}
    projects={projects}
    tasks={tasks}
    client:load
  />
</Layout>

<dialog
  class="glass-panel m-auto w-[min(100%,24rem)] rounded-md p-5 text-text-primary backdrop:bg-black/60"
  id="quick-add-dialog"
>
  <form class="space-y-4" id="quick-add-form">
    <h2 class="font-semibold text-lg">Quick add</h2>
    <p class="text-sm text-text-secondary">
      Capture a task title. You can refine priorities in the detail sheet.
    </p>
    <input
      class="min-h-11 w-full rounded-sm border border-border-contrast bg-surface-subtle px-3 text-text-primary placeholder:text-text-muted focus:border-primary focus:outline-none"
      name="title"
      placeholder="Task title…"
      required
      type="text"
    >
    {projects.length > 0 ? (
      <label class="block space-y-1.5">
        <span class="font-medium text-sm text-text-secondary">Project</span>
        <select
          class="min-h-11 w-full rounded-sm border border-border-contrast bg-surface-subtle px-3 text-text-primary focus:border-primary focus:outline-none"
          name="projectId"
        >
          <option value="">Inbox (no project)</option>
          {projects.map((project: Project) => (
            <option value={project.id}>#{project.name}</option>
          ))}
        </select>
      </label>
    ) : null}
    <p
      class="hidden text-capacity-over text-sm"
      id="quick-add-error"
      role="alert"
    ></p>
    <div class="flex justify-end gap-2">
      <button
        class="min-h-11 rounded-sm border border-border-contrast px-4 text-sm text-text-primary"
        id="quick-add-cancel"
        type="button"
      >
        Cancel
      </button>
      <button
        class="min-h-11 rounded-sm bg-primary px-4 font-semibold text-on-primary text-sm"
        type="submit"
      >
        Add
      </button>
    </div>
  </form>
</dialog>

<div
  aria-live="polite"
  class="pointer-events-none fixed inset-x-0 bottom-24 z-60 flex flex-col items-center gap-2 px-4 lg:bottom-6"
  id="plansage-toast-host"
></div>

<script>
  import { orpc, reportWindowError } from "../lib/orpc";
  import { revalidateOnFocus } from "../lib/revalidate";
  import { showToast, type ToastDetail } from "../lib/toast";

  revalidateOnFocus();

  globalThis.addEventListener("error", (event: ErrorEvent) => {
    reportWindowError(event.error ?? event.message).catch(() => undefined);
  });
  globalThis.addEventListener(
    "unhandledrejection",
    (event: PromiseRejectionEvent) => {
      reportWindowError(event.reason).catch(() => undefined);
    }
  );

  const toastHost = document.getElementById("plansage-toast-host");

  document.addEventListener("plansage:toast", ((
    event: CustomEvent<ToastDetail>
  ) => {
    if (!toastHost) {
      return;
    }
    const { message, tone = "info" } = event.detail;
    const el = document.createElement("div");
    let toneClass =
      "border-border-contrast bg-surface-elevated text-text-primary";
    if (tone === "error") {
      toneClass = "border-capacity-over/40 bg-capacity-over text-on-primary";
    } else if (tone === "success") {
      toneClass = "border-capacity-ok/40 bg-capacity-ok text-on-primary";
    }
    el.className = `pointer-events-auto max-w-sm rounded-sm border px-4 py-3 text-sm shadow-lg ${toneClass}`;
    el.textContent = message;
    toastHost.appendChild(el);
    globalThis.setTimeout(() => {
      el.remove();
    }, 3200);
  }) as EventListener);

  const dialog = document.getElementById(
    "quick-add-dialog"
  ) as HTMLDialogElement | null;
  const form = document.getElementById(
    "quick-add-form"
  ) as HTMLFormElement | null;
  const errorEl = document.getElementById("quick-add-error");
  const cancel = document.getElementById("quick-add-cancel");
  const openQuickAdd = () => {
    errorEl?.classList.add("hidden");
    if (errorEl) {
      errorEl.textContent = "";
    }
    dialog?.showModal();
    form?.querySelector("input")?.focus();
  };

  const triggers = [
    document.getElementById("quick-add-fab"),
    document.getElementById("quick-add-header"),
    document.getElementById("quick-add-sidenav"),
  ];

  for (const trigger of triggers) {
    trigger?.addEventListener("click", openQuickAdd);
  }

  document.addEventListener("plansage:quick-add", openQuickAdd);

  cancel?.addEventListener("click", () => {
    dialog?.close();
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const title = String(data.get("title") ?? "").trim();
    if (!title) {
      return;
    }
    const rawProjectId = String(data.get("projectId") ?? "").trim();
    const projectId = rawProjectId.length > 0 ? rawProjectId : null;

    try {
      await orpc.tasks.create(projectId ? { projectId, title } : { title });
      dialog?.close();
      showToast("Task added", "success");
      location.reload();
    } catch {
      if (errorEl) {
        errorEl.textContent = "Could not create task. Try again.";
        errorEl.classList.remove("hidden");
      }
      showToast("Could not create task. Try again.", "error");
    }
  });

  document.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest?.("[data-add-today]") as HTMLElement | null;
    const id = button?.dataset.addToday;
    if (!id) {
      return;
    }

    event.preventDefault();
    button?.setAttribute("disabled", "true");
    try {
      await orpc.tasks.update({ id, isToday: true });
      showToast("Added to Today", "success");
      location.reload();
    } catch {
      button?.removeAttribute("disabled");
      showToast("Could not add to Today. Try again.", "error");
    }
  });
</script>
