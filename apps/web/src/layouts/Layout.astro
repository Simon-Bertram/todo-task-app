---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  bare?: boolean;
  canonicalPath?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  robots?: string;
  title?: string;
}

const DEFAULT_DESCRIPTION =
  "Stop drowning in endless checklists. PlanSage helps overloaded professionals prioritize with the Eisenhower Matrix and a time-budgeted Today view.";

const {
  title = "PlanSage",
  bare = false,
  description = DEFAULT_DESCRIPTION,
  canonicalPath,
  robots,
  ogImage = "/og.png",
  ogType = "website",
} = Astro.props;

const site = Astro.site ?? new URL("https://todo.sarl");
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;
---

<!doctype html>
<html class="dark" lang="en">
  <head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <Font
      cssVariable="--font-geist"
      preload={[{ style: "normal", subset: "latin", weight: 400 }]}
    />
    <Font cssVariable="--font-jetbrains-mono" />
    <meta content={Astro.generator} name="generator">
    <title>{title}</title>
    <meta content={description} name="description">
    {robots ? <meta content={robots} name="robots" /> : null}
    <link href={canonicalUrl} rel="canonical">
    <meta content={title} property="og:title">
    <meta content={description} property="og:description">
    <meta content={canonicalUrl} property="og:url">
    <meta content={ogImageUrl} property="og:image">
    <meta content={ogType} property="og:type">
    <meta content="PlanSage" property="og:site_name">
    <meta content="summary_large_image" name="twitter:card">
    <meta content={title} name="twitter:title">
    <meta content={description} name="twitter:description">
    <meta content={ogImageUrl} name="twitter:image">
  </head>
  <body class={bare ? "min-h-svh" : "min-h-svh bg-canvas text-text-primary"}>
    <slot />
  </body>
</html>
