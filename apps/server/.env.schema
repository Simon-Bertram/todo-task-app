# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
RESEND_API_KEY=

# Hugging Face access token with Inference Providers permission (avatar generate).
# Empty disables AI generate; gallery avatars still work.
# @optional @type=string
HF_TOKEN=

# Production From must use a Resend-verified domain (mail.todo.sarl).
# Local smoke tests to your own inbox may use: Todo <onboarding@resend.dev>
# @public @type=string(minLength=3)
EMAIL_FROM=PlanSage <noreply@mail.todo.sarl>

# Cloudflare Turnstile secret for Better Auth captcha plugin siteverify.
# Default is the official always-pass test secret (local/dev only).
# Production must use a real widget secret — createAuth rejects the test key
# when NODE_ENV=production.
# @docs(https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
# @type=string(minLength=1)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
