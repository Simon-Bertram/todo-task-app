{
  "extends": "@todo-task-app/config/tsconfig.base.json",
  "references": [{ "path": "../../packages/api" }],
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "cloudflare-env.d.ts", "tsdown.config.ts"],
  "exclude": ["dist"]
}
